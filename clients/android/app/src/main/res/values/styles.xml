<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/megumin_background</item>
        <item name="android:navigationBarColor">@color/megumin_background</item>
        <item name="android:windowBackground">@color/megumin_background</item>
        <item name="android:textColorPrimary">@color/megumin_text</item>
        <item name="android:textColorSecondary">@color/megumin_muted</item>
        <item name="android:colorAccent">@color/megumin_gold</item>
        <item name="android:alertDialogTheme">@style/ExplosionDialog</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="ExplosionScreen" parent="AppTheme">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="ExplosionDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">@drawable/dialog_surface</item>
        <item name="android:colorAccent">@color/megumin_gold</item>
        <item name="android:textColorPrimary">@color/megumin_text</item>
        <item name="android:textColorSecondary">@color/megumin_muted</item>
        <item name="android:buttonBarButtonStyle">@style/ExplosionDialogButton</item>
        <item name="android:windowMinWidthMajor">92%</item>
        <item name="android:windowMinWidthMinor">92%</item>
    </style>
    <style name="ExplosionDialogButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/megumin_text</item>
    </style>
</resources>
