# Copy to .env locally, fill the values, and run: node --env-file=.env src/server.mjs
VAULT_TOKEN=replace-with-a-long-random-server-secret
PORT=8788
VAULT_HOST=127.0.0.1
# HTTPS must be configured before exposing the service outside localhost.
# Optional comma-separated website origins (without a trailing slash).
# AUTH_ALLOWED_ORIGINS=https://memboom.example
